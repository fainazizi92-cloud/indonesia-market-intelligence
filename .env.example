# Never commit real secrets. Copy this file to .env locally.
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=imi
POSTGRES_USER=imi
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://imi:change_me@localhost:5432/imi

# Optional future providers — leave blank until source audit is completed
IDX_DATA_USERNAME=
IDX_DATA_PASSWORD=
BPS_API_KEY=
GLOBAL_MARKET_API_KEY=
OPENAI_API_KEY=
